# Architecture Advisor: local settings.
# Copy this file to .env, fill in what you have, and start the app. Blank lines are fine: any vendor without
# credentials is simulated and clearly labelled "simulated" on every screen. .env is git-ignored; never commit it.

# ---------------------------------------------------------------------------------------------------------------
# Claude (Anthropic API). Also powers the architect (reads your goal, writes test cases) and the answer judge.
#   Get it: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT-5, GPT-5 mini).  Get it: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# xAI (Grok 4, Grok 4 Fast).  Get it: https://console.x.ai  (API Keys)
XAI_API_KEY=

# Google Gemini API (Gemini 2.5 Pro / Flash).  Get it: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------------------------------------------
# Amazon Bedrock: 14 models including Nova, Llama, Mistral, DeepSeek v3.2, Qwen, gpt-oss, Kimi and Claude.
# (DeepSeek is only offered through Bedrock here; there is no direct DeepSeek API in the approved vendor list.)
# Use ONE of: an AWS profile (recommended), or access keys. The identity needs bedrock:ListFoundationModels,
# bedrock:ListInferenceProfiles and bedrock:InvokeModel, and each model must be enabled under Bedrock ->
# Model access in this region.
AWS_REGION=us-east-1
AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------------------------------------------
# Azure AI Foundry.
#   GPT on Azure: your resource endpoint and key (Azure portal -> your Azure OpenAI / Foundry resource -> Keys).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
#   Deployment names, only if yours differ from the model IDs (gpt-5, gpt-5-mini):
# AZURE_DEPLOYMENT_GPT_5=
# AZURE_DEPLOYMENT_GPT_5_MINI=
#   Claude on Azure: the Foundry resource name (not the URL) and its key.
AZURE_FOUNDRY_RESOURCE=
AZURE_FOUNDRY_API_KEY=

# ---------------------------------------------------------------------------------------------------------------
# Not approved by the company vendor policy (knowledge/policy.json), so these are ignored even if set:
#   GOOGLE_CLOUD_PROJECT (Vertex AI), TYPESAFE_API_KEY (Jev)

# ---------------------------------------------------------------------------------------------------------------
# Optional settings
# ARCHITECT_MODEL=claude-sonnet-5        # claude-opus-5 for the strongest reading of goals
# TEST_CASES=40                          # test cases written per goal (8-60); fewer = cheaper but results swing more
# COMPARE_LIMIT_PER_DAY=5                # full comparisons per IP per 24 h
# APP_PASSWORD=                          # require a password (any username) until SSO is in front
# PRICE_SYNC=off                         # skip the price sync at startup (faster start, offline)
